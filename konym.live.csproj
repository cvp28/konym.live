<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<ServerGarbageCollection>false</ServerGarbageCollection>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\mp3\**\*.mp3" />
    <Content Remove="ServerContent\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\mp3\**\*.mp3" />
	<None Include="ServerContent\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Htmx" Version="1.12.0" />
    <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.477" />
    <PackageReference Include="Markdig" Version="1.1.1" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Collections.Pooled">
      <HintPath>Binaries\Collections.Pooled.dll</HintPath>
    </Reference>
    <Reference Include="CosmoSlim">
      <HintPath>Binaries\CosmoSlim.dll</HintPath>
    </Reference>
    <Reference Include="FuzzySharp">
      <HintPath>Binaries\FuzzySharp.dll</HintPath>
    </Reference>
    <Reference Include="Hv2Slim">
      <HintPath>Binaries\Hv2Slim.dll</HintPath>
    </Reference>
    <Reference Include="Utf8StringInterpolation">
      <HintPath>Binaries\Utf8StringInterpolation.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\rpc_bridge.zip">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
