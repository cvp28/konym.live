
<div id="chat-badge" draggable="true" class="site-theme-border flex-vert flex-align-center">
	
	<div id="chat-controls" class="flex-horiz fill-width">
		<span class="fill-width">Chat!</span>

		<button class="fill-width" onclick="ConnectToChat();">Open</button>
		<button class="fill-width" onclick="term.clear();">Clear</button>
		<button class="fill-width" onclick="if (ws.readyState !== 3) ws.close();">Close</button>
		<button class="fill-width" onclick="fit.fit();">Fit</button>
	</div>

	<div id="terminal" />

	<script>
		const term = new Terminal();
		const fit = new FitAddon.FitAddon();

		var ws;

		term.loadAddon(fit);
		term.open(document.getElementById('terminal'));

		term.onWriteParsed(function() {
			term.scrollToBottom();
		});

		fit.fit();

		function ConnectToChat()
		{
			// If we're already connected, return
			if (ws && ws.readyState === 1)
				return;

			ws = new WebSocket(`ws://${location.host}/chat-ws`);

			ws.onopen = function(event) {
				term.writeln('Connected to chat-ws!');
			};

			ws.onclose = function(event) {
				term.writeln('Disconnected!');
			}
		}
	</script>

	<style>
		#chat-badge {
			padding: 10px;
			gap: 20px;
			min-width: 10vw;
			max-width: 15vw;
			max-height: 20vh;
			max-height: 20vh;
		}

		#terminal {
			overflow: hidden;
			width: 100%;
			height: 100%;
		}
	</style>
</div>