<div id="media-player" draggable="true" class="site-theme-border flex-vert flex-justify-center nodblclick">
	<script src="/js/mp3player.js" defer></script>

	<dialog id="mp-list-modal" class="drag-disable site-theme-border"
		
		hx-trigger="mp-list-show-event"
		hx-get="/frag/mp3-list"
		hx-target="this"
		hx-swap="innerHTML"
		hx-indicator="#none"
	>
		
		<span>Getting mp3 list...</span>

	</dialog>

	<!--
		Because people like to bitch moan and complain about <marquee>, here you go 👇
		This is ugly btw.
	-->

	<div class="marquee"><span id="media-name" class="marquee-15s">Select a track!</span></div>

	<audio preload="metadata" id="audio-src" />

	<div id="mp-controls" class="flex-horiz">
		<button class="mp3-btn" data-action="play"/>
		<button class="mp3-btn" data-action="random"/>
		<button class="mp3-btn" data-action="list"/>
		<input id="volume-slider" data-action="volume" class="drag-disable fill-width" type="range" name="Volume" min="0" max="1" value="0.5" step="0.01" />
	</div>

	<input id="seek-slider" data-action="seek" class="drag-disable fill-width" type="range" name="Seek" min="0" value="1" step="1" />
</div>