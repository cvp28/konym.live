<div id="content" class="flex-vert flex-align-center" align="center">
    <link rel="stylesheet" href="/style/zones.css"/>

    <div class="fill-width flex-vert flex-align-center">
        <span style="font-family: '3dthirteen'; font-size: 5cqi;">Select a Zone</span>
        <hr class="fill-width" />
    </div>

    <div id="content-zones-home" class="flex-horiz flex-justify-center flex-align-center fill-width fill-height">
        <a id="technology-btn"
           class="zone-home-btn flex-vert flex-align-center flex-justify-center"
           href="@APIUtils.ZoneRoutes[Zone.Technology]">
            Technology
        </a>

        <a id="life-btn"
            class="zone-home-btn flex-vert flex-align-center flex-justify-center"
            href="@APIUtils.ZoneRoutes[Zone.Life]"
        >
            Life
        </a>

        <a id="cars-and-bikes-btn"
           class="zone-home-btn flex-vert flex-align-center flex-justify-center"
           href="@APIUtils.ZoneRoutes[Zone.CarsAndBikes]"
        >
            Cars and <br />Bikes
        </a>
    </div>
</div>
