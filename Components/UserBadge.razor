<div
    id="active-users"
    draggable="true"
    
    hx-indicator="#none"

    hx-post="/frag/active-users"
    hx-trigger="load, every 5s [document.hidden === false]"

    hx-target="#badge"
    hx-swap="outerHTML"
    >

    <span id="badge">🌎 Getting user count...</span>

    <style>
        #active-users {
            cursor: grab;
            padding: 5px;
            text-align: center;
            border: 2px solid rgb(0,255, 0, 0.7);
            font-size: 1cqi;
            z-index: 999;
        }
    </style>

</div>