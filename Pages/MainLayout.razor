@using konym.live.Components

<!DOCTYPE HTML>

<html>
<head>
    <meta charset="UTF-8" />
    <title>konym.live</title>
    <link rel="stylesheet" href="/style/site.min.css"/>
    <link rel="shortcut icon" type="image/x-icon" href="/images/favicon.ico">

    <script src="js\draggable.js" defer></script>
    <script src="js\contextmenu.js" defer></script>

    <!--Prevent blinding FUOC (Flash-of-unstyled-content)-->
    <style>
        html { background-color: black; }
    </style>
    
    <meta name="htmx-config" content='{"allowScriptTags": true, "history": "reload"}'>
    <HtmxInclude/>
</head>

<body 
    hx-boost:inherited="true"
    hx-target:inherited="#content"
    hx-swap:inherited="outerHTML"
    hx-indicator:inherited="this, #global-loading, #content"
    
    ondragover="event.preventDefault()"
    ondragenter="event.preventDefault()">

    <img id="global-loading" src="/images/aero_spinner.gif"/>

    <ContextMenu />
    <Mp3Player />
    <Chat />

    <div id="root" class="flex-horiz">
        <div id="root-left" class="flex-vert">
            <Navbar/>
            <UserBadge/>
        </div>

        @Content
    </div>
</body>
</html>

@code
{
    [Parameter] public RenderFragment Content { get; set; }
}