<div id="chat-badge" draggable="true" class="site-theme-border flex-vert flex-align-center nodblclick">
	<script src="/js/chat.js" defer></script>
	<link id="xterm-css" rel="preload" href="https://unpkg.com/@@xterm/xterm/css/xterm.css" as="style"/>
	
	<div id="chat-controls" class="term-theme flex-horiz fill-width">
		<span class="fill-width"> textmode.konym.live</span>
		<button class="term-btn" onclick="DisconnectFromChat();">[Disconnect]</button>
	</div>

	<div id="connect-div" class="term-theme flex-vert flex-align-center flex-justify-center">
		<button class="term-btn" onclick="ConnectToChat();">[Connect to Chat]</button>
		<br />
		<button class="term-btn" onclick="Toggle(chat);">[Close Window]</button>
	</div>

	<div id="loading-div" style="display: none;" class="term-theme">
		<span>Please wait...</span>
	</div>

	<div id="terminal" />
</div>