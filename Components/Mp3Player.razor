<div draggable="true" id="media-player" class="flex-vert flex-justify-center">

	@{
		var filename = Globals.RandomMp3File;
	}

	<!--
		Because people like to bitch moan and complain about <marquee>, here you go 👇
		This is ugly btw.
	-->

	<div class="marquee"><span id="media-name" class="marquee-15s">@filename</span></div>

	<audio preload="auto" id="audio-src" src="/mp3/@filename" />

	<div id="media-player-controls" class="flex-horiz">
		<button id="play"><img src="images/playpause.png"/></button>
		<button id="random"><img src="images/shuffle.png" /></button>
		<button id="list"><img src="images/list.png" /></button>
		<input id="volume" class="drag-disable fill-width" type="range" name="Volume" min="0" max="1" value="1" step="0.01" />
	</div>

	<input id="seek" class="drag-disable fill-width" type="range" name="Seek" min="0" value="1" step="1" />

	<script src="js/mp3player.js"></script>
	<style>
		#media-player {
			width: 100%;
			max-width: 15vw;
		}

		#play img {
			aspect-ratio: 1/1;
			max-width: 15%
		}

		#random img {

		}

		#list img {

		}
	</style>
</div>