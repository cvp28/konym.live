<div id="nav" class="flex-vert flex-align-center fill-height">

	<img id="logo" src="/images/logo.jpg">

	<a	hx-trigger="click"
		hx-get="/"
		hx-push-url="/"
		hx-target=".content"
		hx-swap="outerHTML">
		<span id="navbar-header">konym.live</span>
	</a>

    <div id="navlist">
		<a class="navlink" href="/">Home</a>
		<a class="navlink" href="/about">About</a>
		<a class="navlink" href="/zones">Zones</a>
        <a class="navlink" href="/i-made-this">I Made This</a>
        <a class="navlink" href="/shadez-2-full">Shadez 2</a>
    </div>

	<a id="button-image" title="Click to copy html">
		<img src="/images/button.png" />
	</a>

	<span id="void-fill" />

	<button
		id="random-vid-refresh"
		class="navlink"
		style="width: stretch; cursor: pointer;"
		
		hx-indicator="#none"

		hx-get="/frag/random-song"
		hx-target="#media-player"
		hx-swap="innerHTML"
	>New Random Song</button>

	<div id="media-player" class="flex-vert flex-justify-center">

		@{
			var filename = Globals.RandomMp3File;
		}

		<marquee>@filename</marquee>

		<audio preload="auto" id="audio-src" src="/mp3/@filename"/>

		<button id="play">▶</button>
		<input id="seek" type="range" name="Seek" min="0" value="1" step="1"/>

		<script>
			const audio = document.getElementById("audio-src");
			const play = document.getElementById("play");
			const seek = document.getElementById("seek");

			// handle play/pause
			play.addEventListener("click", function ()
			{
				if (audio.paused)
				{
					audio.play();
					play.textContent = "⏸";
				}
				else
				{
					audio.pause();
					play.textContent = "▶";
				}
			});

			audio.addEventListener("loadedmetadata", function ()
			{
				seek.max = audio.duration;
			});

			// update seek bar
			audio.ontimeupdate = function()
			{
				seek.value = audio.currentTime;
			};

			audio.onended = function()
			{
				seek.value = 0;
				audio.currentTime = 0;
				play.textContent = "▶";
			};

			seek.addEventListener("input", function ()
			{
				audio.currentTime = seek.value;
			});
		</script>
	</div>


	<style>
		#media-player {
			/*width: 105cqi;*/
		}

		#nav {
			border: 2px solid rgba(196, 255, 0, 0.5);
			background: linear-gradient(190deg,rgba(0, 65, 115, 0.54) 0%, rgba(196, 177, 0, 0.34) 100%);
			
			font-family: 'Segoe UI';

			container-type: inline-size;

			flex: 4;
			gap: 0.5cqi;

			min-width: 11cqi;

			padding: 20px;
		}

		#logo {
			width: stretch;
		}

		#navbar-header {
			font-family: '3dthirteen';
			font-size: 20cqi;
			
			transition: text-shadow 0.3s ease;
		}

		#navbar-header:hover {
			cursor: pointer;
			text-shadow: -1px -1px 0 #FFF, 1px -1px 0 #FFF, -1px 1px 0 #FFF, 1px 1px 0 #FFF;
		}

		#navlist {
			width: stretch;
		}

		.navlink {
			color: burlywood;
			background-color: black;
			border: 1px solid white;
			border-image: linear-gradient(190deg,rgba(0, 65, 115, 1), rgba(196, 177, 0, 1)) 1;

			text-align: center;
			font-size: 7cqi;
			font-weight: bold;
			text-decoration: none;

			padding: 5px;
			margin: 5px 0px;

			display: block;
		}

		#button-image {
			width: 88px;
			height: 31px;
		}

		#button-image:hover {
			cursor: pointer;
		}

		#void-fill {
			flex-grow: 1;
		}

		.active {
			text-decoration: underline;
		}

		.navlink:hover {
			background: transparent;
			border: 1px solid white;
			/*border-image: linear-gradient(90deg,rgba(0, 65, 115, 0.54), rgba(0, 0, 0, 1), rgba(196, 177, 0, 0.34)) 1;*/
		}
	</style>

	<script>
		document.body.addEventListener("htmx:afterSwap", function() {
			// Get the current page's URL
			const currentUrl = window.location.href;

			// Select all anchor tags within the navbar
			const navLinks = document.querySelectorAll("#navlist a");

			// Loop through the links and add the 'active' class to the matching one
			navLinks.forEach(link =>
			{
				if (link.href === currentUrl)
					link.classList.add('active');
				else
					link.classList.remove('active');

			});

			const clipboard = document.getElementById("button-image");

			clipboard.onclick = async function(event)
			{
				await navigator.clipboard.writeText(`<a target="_blank" href="https://konym.live" title="To konym.live"><img style="width: 88px; height: 31px" src="https://konym.live/images/button.png" /></a>`);
				alert("Copied button html!");
			};
		});
	</script>
</div>