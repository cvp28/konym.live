@using konym.live.Components

<div id="content" class="flex-vert flex-align-center" align="center">
    <link rel="stylesheet" href="/style/index.css"/>

    <div class="fill-width flex-vert flex-align-center">
        <span style="font-family: '3dthirteen'; font-size: 5cqi;">Home</span>
        <hr class="fill-width" />
    </div>

    <div id="content-introduction" class="flex-vert">

        <h3>Hello, my name is Konym.</h3>
        <p>
            I've put together this website as a coding exercise and semi-commitment to learning web development and long-term project maintenance.<br />
            <br/>
			This is very much a labor of love, so you'll find some personal effects added in.<br />
            (music, blog posts, images, etc.)<br />
            <br/>
            For concerns surrounding AI usage, please read my AI disclaimer <a href="/ai" style="color: lightgreen">here</a>.
        </p>

        <p style="display: none;">
            Of course, that's an alias. Maybe one day you'll know my real name.<br />
            Maybe you already do!<br />
            <br />
            Anyways, are you the kind of person that others immediately call upon to sort out technical issues? If so, we'll probably get along.<br />
            <br />
            I am a bit of a computer nerd who finally decided, in Feb. 2026, to fulfill a dream of his 14 year-old self by creating and hosting a cool website.<br />
            <br />
            Whether you actually agree that any of this is cool is entirely up to you :p<br />
            <br />
            My hobbies include coding (no shit), riding my motorcycle, gaming, and hanging out with my friends both online and <b><i>in real life</i></b> :o<br />
            <br />
            You may find me out there on the internet from time to time.<br />
            Be sure to say hi if you do. Thanks for visiting!
        </p>
    </div>

    <div id="content-buttons" class="flex-horiz" style="gap: 10px;">
        <a target="_blank" style="width: 88px; height: 31px" href="https://nexb13.github.io/netstation/index.htm" title="Logon to the Net Station!">
            <img style="width: inherit; height: inherit" src="/images/nexb13_button.png" alt="Join us at the Net Station">
        </a>

        <a target="_blank" style="width: 88px; height: 31px" href="https://avery501.neocities.org/" title="The Nook">
            <img style="width: inherit; height: inherit" src="https://avery501.neocities.org/logo.png" alt="Witness The Nook">
        </a>

        <a target="_blank" style="width: 88px; height: 31px" href="https://onio.neocities.org" title="Visit Onio Café">
            <img style="width: inherit; height: inherit" src="https://onio.neocities.org/thebutton.gif" alt="Come Chat With Us!">
        </a>
    </div>

    <div id="content-news" class="flex-vert flex-align-center flex-justify-center site-theme-border">
        <div id="news-search" class="flex-horiz">
            <input  
                    id="news-search-field"
                    class="site-theme-border"

                    type="search"
                    name="q"
                    placeholder="Search Changelog..."
                    autocomplete="off"

                    hx-get="/frag/changelog-search"
                    hx-trigger="input changed delay:250ms, keyup[key=='Enter']"
                    hx-target="#news-view"
                    hx-swap="innerHTML"
                    
            />

            <button hx-get="/frag/changelog-search?q=" hx-target="#news-view" hx-swap="innerHTML" onclick="document.getElementById('news-search-field').value = '';">Get List</button>
        </div>

        <div id="news-view" class="flex-vert">
            <!--<span class="news-item-date news-item-pinned" style="color: lightgreen;" align="center">Pinned</span>-->
            
            @{
                var Latest = Globals.ChangelogCache.Last();
                <Changelog Date="Latest.Key" HTMLContent="Latest.Value"/>
            }
        </div>
    </div>
</div>