
@foreach (var Topic in Topics)
{
	var date = Topic.Date.ToString("MM-dd-yyyy");

	<a class="zone-btn glowing-btn fill-width flex-horiz flex-align-center"

	   hx-trigger="click"
	   hx-get="@APIUtils.ZoneRoutes[ZoneVal]"
	   hx-vals='{"date": "@date"}'
	   
	   hx-target="#zone-topics"
	   hx-swap="innerHTML"

	   hx-push-url="@APIUtils.ZoneRoutes[ZoneVal]?date=@date"
	   hx-indicator="#content, #global-loading"
	>
		<div>
			@Topic.Title<br />@date
		</div>
	</a>
}


@code {
	[Parameter]
	public Zone ZoneVal { get; set; }

	[Parameter]
	public List<(string Title, DateOnly Date)> Topics { get; set; }
}